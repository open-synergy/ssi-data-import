"  - env, document, time, datetime, dateutil, timezone, float_compare, b64encode, b64decode\n"
"  - row: dict of the current file row, keyed by column\n"
"  - value: raw value of Column in the current row\n"
"  - record, target, line: only set while Apply runs -- referencing them fails at Resolve (Preview) time"
msgstr ""

#. module: ssi_data_import
#: model:ir.model.fields,help:ssi_data_import.field_data_import_template_action__python_code
msgid ""
"Python statements run directly against the matched record. Used by Python Code, only run at Apply time -- never evaluated for Preview. Available variables:\n"
"  - env, document, time, datetime, dateutil, timezone, float_compare, b64encode, b64decode\n"
"  - row: dict of the current file row, keyed by column\n"
"  - value: raw value of Column in the current row\n"
"  - record: resolved Target Model record\n"
"  - target: record resolved from Target Path\n"
"  - line: the data_import.data line being applied\n"

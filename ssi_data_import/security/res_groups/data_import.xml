<odoo>
<!-- Workflow Groups: Viewer -> User -> Validator -->
<record id="data_import_viewer_group" model="res.groups">
    <field name="name">Viewer</field>
    <field name="category_id" ref="data_import_workflow_module_category" />
</record>

<record id="data_import_user_group" model="res.groups">
    <field name="name">User</field>
    <field name="category_id" ref="data_import_workflow_module_category" />
    <field name="implied_ids" eval="[(4, ref('data_import_viewer_group'))]" />
</record>

<record id="data_import_validator_group" model="res.groups">
    <field name="name">Validator</field>
    <field name="category_id" ref="data_import_workflow_module_category" />
    <field name="implied_ids" eval="[(4, ref('data_import_user_group'))]" />
    <field
            name="users"
            eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"
        />
</record>

<!-- Data Ownership Groups -->
<record id="data_import_company_group" model="res.groups">
    <field name="name">Company</field>
    <field name="category_id" ref="data_import_data_ownership_module_category" />
</record>

<record id="data_import_company_child_group" model="res.groups">
    <field name="name">Company and All Child Companies</field>
    <field name="category_id" ref="data_import_data_ownership_module_category" />
    <field
            name="implied_ids"
            eval="[(4, ref('data_import_company_group'))]"
        />
</record>

<record id="data_import_all_group" model="res.groups">
    <field name="name">All</field>
    <field name="category_id" ref="data_import_data_ownership_module_category" />
    <field
            name="implied_ids"
            eval="[(4, ref('data_import_company_child_group'))]"
        />
</record>
</odoo>

<odoo>
<record id="ignore_data_import_row_view_form" model="ir.ui.view">
    <field name="name">ignore_data_import_row - form</field>
    <field name="model">ignore_data_import_row</field>
    <field name="arch" type="xml">
        <form>
            <field name="data_id" invisible="1" />
            <group name="group_1" colspan="4" col="2">
                <field name="reason" nolabel="1" colspan="2" placeholder="Reason..." />
            </group>
            <footer>
                <button
                        name="action_confirm"
                        type="object"
                        string="Save"
                        class="btn-primary"
                    />
                <button string="Cancel" class="btn-default" special="cancel" />
            </footer>
        </form>
    </field>
</record>
</odoo>

<odoo noupdate="0">
<record id="data_import_policy_template" model="policy.template">
    <field name="name">Standard</field>
    <field name="model_id" ref="model_data_import" />
    <field
            name="state_field_id"
            search="[('model_id.model','=','data_import'),('name','=','state')]"
        />
    <field name="sequence" eval="100" />
    <field name="python_code">result=True</field>
</record>

<!-- confirm -->
<record id="data_import_policy_template_detail_confirm" model="policy.template_detail">
    <field name="template_id" ref="data_import_policy_template" />
    <field
            name="field_id"
            search="[('model_id.model','=','data_import'),('name','=','confirm_ok')]"
        />
    <field name="restrict_state" eval="1" />
    <field
            name="state_ids"
            search="[('field_id.model_id.model','=','data_import'),('value','=','draft')]"
        />
    <field name="restrict_user" eval="1" />
    <field name="computation_method">use_group</field>
    <field name="group_ids" eval="[(6,0,[ref('data_import_user_group')])]" />
    <field name="restrict_additional" eval="0" />
</record>

<!-- approve -->
<record id="data_import_policy_template_detail_approve" model="policy.template_detail">
    <field name="template_id" ref="data_import_policy_template" />
    <field
            name="field_id"
            search="[('model_id.model','=','data_import'),('name','=','approve_ok')]"
        />
    <field name="restrict_state" eval="1" />
    <field
            name="state_ids"
            search="[('field_id.model_id.model','=','data_import'),('value','=','confirm')]"
        />
    <field name="restrict_user" eval="0" />
    <field name="restrict_additional" eval="1" />
    <field name="additional_python_code">result = False
if env.user.id in document.active_approver_user_ids.ids:
    result = True
    </field>
</record>

<!-- reject -->
<record id="data_import_policy_template_detail_reject" model="policy.template_detail">
    <field name="template_id" ref="data_import_policy_template" />
    <field
            name="field_id"
            search="[('model_id.model','=','data_import'),('name','=','reject_ok')]"
        />
    <field name="restrict_state" eval="1" />
    <field
            name="state_ids"
            search="[('field_id.model_id.model','=','data_import'),('value','=','confirm')]"
        />
    <field name="restrict_user" eval="0" />
    <field name="restrict_additional" eval="1" />
    <field name="additional_python_code">result = False
if env.user.id in document.active_approver_user_ids.ids:
    result = True
    </field>
</record>

<!-- restart approval -->
<record
        id="data_import_policy_template_detail_restart_approval"
        model="policy.template_detail"
    >
    <field name="template_id" ref="data_import_policy_template" />
    <field
            name="field_id"
            search="[('model_id.model','=','data_import'),('name','=','restart_approval_ok')]"
        />
    <field name="restrict_state" eval="1" />
    <field
            name="state_ids"
            search="[('field_id.model_id.model','=','data_import'),('value','=','confirm')]"
        />
    <field name="restrict_user" eval="1" />
    <field name="computation_method">use_group</field>
    <field
            name="group_ids"
            eval="[(6,0,[ref('data_import_validator_group')])]"
        />
    <field name="restrict_additional" eval="1" />
    <field name="additional_python_code">result = False
if not document.approval_template_id:
    result = True
    </field>
</record>

<!-- cancel -->
<record id="data_import_policy_template_detail_cancel" model="policy.template_detail">
    <field name="template_id" ref="data_import_policy_template" />
    <field
            name="field_id"
            search="[('model_id.model','=','data_import'),('name','=','cancel_ok')]"
        />
    <field name="restrict_state" eval="1" />
    <field
            name="state_ids"
            search="[('field_id.model_id.model','=','data_import'),('value','in',['draft','confirm','queue_done','done'])]"
        />
    <field name="restrict_user" eval="1" />
    <field name="computation_method">use_group</field>
    <field
            name="group_ids"
            eval="[(6,0,[ref('data_import_validator_group')])]"
        />
    <field name="restrict_additional" eval="0" />
</record>

